{
  "name": "anatomy-model",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Interactive 3D anatomy model for physiotherapy patient education",
  "scripts": {
    "start": "vite --open",
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview --open",
    "check": "node tests/check-viewer.mjs",
    "check:regions": "node tests/check-regions.mjs",
    "check:select": "node tests/check-select.mjs",
    "check:highlights": "node tests/check-highlights.mjs",
    "build:models": "node scripts/build-models.mjs",
    "export": "node scripts/build-models.mjs --only export",
    "compress": "node scripts/compress.mjs",
    "build:data": "node scripts/build-data.mjs",
    "previews": "node scripts/build-models.mjs --only previews"
  },
  "devDependencies": {
    "@gltf-transform/core": "4.5.1",
    "@gltf-transform/extensions": "4.5.1",
    "@gltf-transform/functions": "4.5.1",
    "meshoptimizer": "1.3.0",
    "playwright": "1.65.1",
    "vite": "8.3.8"
  },
  "dependencies": {
    "@fontsource/atkinson-hyperlegible": "5.3.0",
    "three": "0.187.0",
    "three-mesh-bvh": "0.9.18"
  }
}
